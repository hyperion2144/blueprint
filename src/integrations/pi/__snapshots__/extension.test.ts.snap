// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pi extension template source (T-3) > emits a matching snapshot 1`] = `
"/**
 * bp Pi Extension - generated by bp update. Do not edit manually.
 *
 * WARNING: logic mirrors src/integrations/pi/extension-runtime.ts;
 * change both or the extension.test.ts snapshot will drift.
 *
 * Provides pi with:
 *   - session_start: <bp-context> block + role-augmented payload
 *   - bp_subagent: delegate bp workflow tasks to isolated pi subagents
 *
 * No per-LLM-call lifecycle hooks (before_agent_start / context): the
 * conversation is only touched once per session at session_start.
 *
 * Env bypass: BP_HOOKS=0 or BP_DISABLE_HOOKS=1 disables every handler.
 * Config skip: handlers no-op when bp/config.yaml is missing at ctx.cwd.
 */
import { existsSync, readFileSync, readdirSync, rmSync, mkdtempSync, writeFileSync } from "node:fs";
import { spawn, execSync } from "node:child_process";
import { join, resolve, sep, dirname, basename } from "node:path";
import { tmpdir } from "node:os";
import { defineTool, parseFrontmatter, type ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { Type } from "@earendil-works/pi-ai";

function isDisabled(): boolean {
  return process.env.BP_HOOKS === "0" || process.env.BP_DISABLE_HOOKS === "1";
}

function hasBpConfig(cwd: string | undefined): boolean {
  if (!cwd) return false;
  return existsSync(join(cwd, "bp", "config.yaml"));
}

/**
 * Defense-in-depth: assert a resolved path stays under bp/changes/.
 * activeChangeName is derived from bp state — if tampered with, '..'
 * segments could otherwise let the extension read arbitrary files.
 */
function assertWithinChanges(bpDir: string, changeName: string): void {
  const changesRoot = resolve(join(bpDir, "changes")) + sep;
  const target = resolve(join(bpDir, "changes", changeName));
  if (!target.startsWith(changesRoot)) {
    throw new Error("Path traversal blocked: " + changeName + " escapes bp/changes/");
  }
}

function formatState(st: Record<string, any>): string {
  const lines: string[] = [];
  if (st.milestone) lines.push(st.milestone.id + ": " + st.milestone.name + " [" + st.milestone.status + "]");
  if (st.phase) lines.push("  Phase " + st.phase.id + ": " + st.phase.name + " [" + st.phase.status + "]");
  if (st.activeChange) lines.push("  Active: " + st.activeChange.name + " [" + st.activeChange.status + "]");
  if (st.nextAction) lines.push("  Next: " + st.nextAction);
  return lines.join("\\n") || "_no state available_";
}

function readBpState(cwd: string): { summary: string; activeChangeName?: string } {
  try {
    const out = execSync("bp state --json", { cwd: cwd, encoding: "utf-8", timeout: 3000 });
    const st = JSON.parse(out as string);
    return {
      summary: formatState(st),
      activeChangeName: st.activeChange ? st.activeChange.name : undefined,
    };
  } catch {
    return { summary: "_no state available_", activeChangeName: undefined };
  }
}

const AGENT_TYPE_MARKERS: Array<[string, string]> = [
  ["planner", "Change Design Specialist"],
  ["executor", "Code Implementation Specialist"],
  ["reviewer", "Triple Review Specialist"],
  ["codebase-scanner", "Codebase Scanner"],
  ["refactorer", "You are the **refactorer** sub-agent"],
  ["fixer", "You are the **bp-fixer** sub-agent"],
  ["designer", "Design Consultant"],
];

// Role-title phrases from the real AGENT_PROMPTS bodies (src/templates/agents/index.ts).
// Bare role-name substrings do NOT exist in the shipped prompts and cross-contaminate
// (the reviewer body mentions "executor", the fixer body mentions "reviewer").
function detectAgentType(prompt: string | undefined): string {
  if (!prompt) return "default";
  for (const [agentType, marker] of AGENT_TYPE_MARKERS) {
    if (prompt.includes(marker)) return agentType;
  }
  return "default";
}

function generateCompactBlock(cwd: string): string {
  if (!cwd || !hasBpConfig(cwd)) {
    return "<bp-context>\\n</bp-context>";
  }
  try {
    const out = execSync("bp context plan --format=compact", { cwd: cwd, encoding: "utf-8", timeout: 5000 });
    return (out as string).trim() || "<bp-context>\\n</bp-context>";
  } catch {
    return "<bp-context>\\n</bp-context>";
  }
}

function readContextRows(bpDir: string, changeName: string | undefined): Array<Record<string, any>> {
  if (!changeName) return [];
  try {
    assertWithinChanges(bpDir, changeName);
  } catch {
    return [];
  }
  const path = join(bpDir, "changes", changeName, "context.jsonl");
  if (!existsSync(path)) return [];
  try {
    const content = readFileSync(path, "utf-8");
    const rows: Array<Record<string, any>> = [];
    for (const line of content.split("\\n")) {
      if (!line.trim()) continue;
      try {
        rows.push(JSON.parse(line));
      } catch {
        // skip malformed rows
      }
    }
    return rows;
  } catch {
    return [];
  }
}

function readTasksContent(bpDir: string, changeName: string | undefined): string {
  if (!changeName) return "";
  try {
    assertWithinChanges(bpDir, changeName);
  } catch {
    return "";
  }
  const path = join(bpDir, "changes", changeName, "tasks.md");
  if (!existsSync(path)) return "";
  try {
    return readFileSync(path, "utf-8");
  } catch {
    return "";
  }
}

function extractSummaryBlock(report: string): string | null {
  const summaryIdx = report.indexOf("## Summary");
  if (summaryIdx === -1) return null;
  const afterHeading = summaryIdx + "## Summary".length;
  const nextSection = report.indexOf("\\n## ", afterHeading);
  const end = nextSection === -1 ? report.length : nextSection;
  return report.slice(summaryIdx, end).trim();
}

function augmentBody(agentType: string, cwd: string, activeChangeName: string | undefined): string {
  let body = generateCompactBlock(cwd);
  if (agentType === "default") return body;
  const bpDir = join(cwd, "bp");

  if (agentType === "planner") {
    body = body + "\\n\\n## Roadmap State\\n" + readBpState(cwd).summary;
  } else if (agentType === "designer") {
    // Read-only design role: paths-only context, no augmentation. Explicit
    // branch is the future hook for design-specific state.
  } else if (agentType === "executor" || agentType === "fixer") {
    const rows = readContextRows(bpDir, activeChangeName);
    const lines = rows.length === 0
      ? ["_no context.jsonl rows_"]
      : rows.map((r) => {
          const prefix = r.tag === "guard-rail" ? "> GUARD-RAIL: " : "";
          const phase = r.phase ? " [" + r.phase + "]" : "";
          return prefix + "file: " + r.file + phase + " | reason: " + r.reason;
        });
    body = body + "\\n\\n" + lines.join("\\n");
  } else if (agentType === "reviewer") {
    const invRows = readContextRows(bpDir, activeChangeName);
    const invariants = invRows.length === 0
      ? "_no context.jsonl rows_"
      : invRows.map((r) => "- " + r.reason).join("\\n");
    body = body + "\\n\\n## Invariants\\n" + invariants;
    const tasks = readTasksContent(bpDir, activeChangeName).trim();
    if (tasks) {
      body = body + "\\n\\n## tasks.md acceptance\\n" + tasks;
    }
  } else if (agentType === "refactorer") {
    const reportPath = join(bpDir, ".refactor-report.md");
    if (existsSync(reportPath)) {
      const summaryBlock = extractSummaryBlock(readFileSync(reportPath, "utf-8"));
      if (summaryBlock) {
        body = body + "\\n\\n## Refactor Targets\\n" + summaryBlock;
      }
    }
  }

  return body;
}

function buildStateMessage(customType: string, content: string) {
  return {
    role: "custom",
    customType: customType,
    content: content,
    display: false,
    timestamp: Date.now(),
  };
}

// ── bp_subagent tool helpers ─────────────────────────────────────────────

function parseToolList(value: unknown): string[] {
  const raw = Array.isArray(value) ? value : typeof value === "string" ? value.split(",") : [];
  return raw
    .filter((t): t is string => typeof t === "string")
    .map((t) => t.trim())
    .filter((t) => t.length > 0);
}

function loadPiAgents(agentsDir: string): Array<Record<string, any>> {
  if (!existsSync(agentsDir)) return [];
  let entries: any[];
  try {
    entries = readdirSync(agentsDir, { withFileTypes: true }) as any[];
  } catch {
    return [];
  }
  const agents: Array<Record<string, any>> = [];
  for (const entry of entries) {
    if (!entry.name.endsWith(".md")) continue;
    if (!entry.isFile() && !entry.isSymbolicLink()) continue;
    const filePath = join(agentsDir, entry.name);
    let content: string;
    try {
      content = readFileSync(filePath, "utf-8");
    } catch {
      continue;
    }
    const parsed = parseFrontmatter(content);
    const fm = (parsed.frontmatter ?? {}) as Record<string, any>;
    if (typeof fm.name !== "string" || typeof fm.description !== "string") continue;
    agents.push({
      name: fm.name,
      description: fm.description,
      tools: parseToolList(fm.tools),
      model: typeof fm.model === "string" ? fm.model : undefined,
      systemPrompt: parsed.body ?? "",
      filePath: filePath,
    });
  }
  return agents;
}

function findPiAgentsDir(cwd: string): string | null {
  let current = cwd;
  while (true) {
    const candidate = join(current, ".pi", "agents");
    if (existsSync(candidate)) return candidate;
    const parent = dirname(current);
    if (parent === current) return null;
    current = parent;
  }
}

function getPiInvocation(args: string[]): { command: string; args: string[] } {
  const currentScript = process.argv[1];
  const isBunVirtualScript = currentScript?.startsWith("/$bunfs/root/");
  if (currentScript && !isBunVirtualScript && existsSync(currentScript)) {
    return { command: process.execPath, args: [currentScript, ...args] };
  }
  const execName = basename(process.execPath).toLowerCase();
  const isGenericRuntime = /^(node|bun)(\\.exe)?$/.test(execName);
  if (!isGenericRuntime) {
    return { command: process.execPath, args: args };
  }
  return { command: "pi", args: args };
}

function writePromptToTempFile(systemPrompt: string): { dir: string; filePath: string } {
  const dir = mkdtempSync(join(tmpdir(), "bp-subagent-"));
  const filePath = join(dir, "prompt.md");
  writeFileSync(filePath, systemPrompt, { encoding: "utf-8", mode: 0o600 });
  return { dir: dir, filePath: filePath };
}

function parseJsonLine(line: string): any {
  if (!line.trim()) return null;
  try {
    return JSON.parse(line);
  } catch {
    return null;
  }
}

function runPiSubagent(
  agent: Record<string, any>,
  task: string,
  cwd: string,
  opts: { signal?: AbortSignal; model?: string; thinkingLevel?: string },
): Promise<{ exitCode: number; messages: any[]; stderr: string }> {
  const args: string[] = ["--mode", "json", "-p", "--no-session"];
  const model = opts.model || agent.model;
  if (model) args.push("--model", model);
  if (opts.thinkingLevel) args.push("--thinking", opts.thinkingLevel);
  if (agent.tools && agent.tools.length > 0) args.push("--tools", agent.tools.join(","));
  let tmpPromptDir: string | null = null;
  if (agent.systemPrompt && agent.systemPrompt.trim()) {
    const tmp = writePromptToTempFile(agent.systemPrompt);
    tmpPromptDir = tmp.dir;
    args.push("--append-system-prompt", tmp.filePath);
  }
  args.push("Task: " + task);

  const messages: any[] = [];
  let stderr = "";

  return new Promise((resolvePromise) => {
    const invocation = getPiInvocation(args);
    const proc = spawn(invocation.command, invocation.args, {
      cwd: cwd,
      shell: false,
      stdio: ["ignore", "pipe", "pipe"],
    });
    let buffer = "";

    const processLine = (line: string) => {
      const event = parseJsonLine(line);
      if (event && event.type === "message_end" && event.message) {
        messages.push(event.message);
      }
    };

    proc.stdout.on("data", (data) => {
      buffer += data.toString();
      const lines = buffer.split("\\n");
      buffer = lines.pop() || "";
      for (const line of lines) processLine(line);
    });

    proc.stderr.on("data", (data) => {
      stderr += data.toString();
    });

    const cleanup = () => {
      if (tmpPromptDir) rmSync(tmpPromptDir, { recursive: true, force: true });
    };

    proc.on("close", (code) => {
      if (buffer.trim()) processLine(buffer);
      cleanup();
      resolvePromise({ exitCode: code ?? 0, messages: messages, stderr: stderr });
    });

    proc.on("error", () => {
      cleanup();
      resolvePromise({ exitCode: 1, messages: messages, stderr: stderr });
    });

    if (opts.signal) {
      const killProc = () => {
        proc.kill("SIGTERM");
        setTimeout(() => {
          if (!proc.killed) proc.kill("SIGKILL");
        }, 5000);
      };
      if (opts.signal.aborted) killProc();
      else opts.signal.addEventListener("abort", killProc, { once: true });
    }
  });
}

async function mapWithConcurrencyLimit<T>(
  items: T[],
  concurrency: number,
  fn: (item: T, index: number) => Promise<any>,
): Promise<any[]> {
  if (items.length === 0) return [];
  const limit = Math.max(1, Math.min(concurrency, items.length));
  const results = new Array(items.length);
  let nextIndex = 0;
  const workers = new Array(limit).fill(null).map(async () => {
    while (true) {
      const current = nextIndex++;
      if (current >= items.length) return;
      results[current] = await fn(items[current], current);
    }
  });
  await Promise.all(workers);
  return results;
}

const bpSubagentTool = defineTool({
  name: "bp_subagent",
  label: "BP Subagent",
  description: "Delegate bp workflow tasks (plan/apply/check/archive/refactor) to isolated bp subagents from .pi/agents/. Modes: single (agent + task) or parallel (tasks array).",
  parameters: Type.Object({
    agent: Type.Optional(Type.String()),
    task: Type.Optional(Type.String()),
    tasks: Type.Optional(Type.Array(Type.Object({ agent: Type.String(), task: Type.String() }))),
    cwd: Type.Optional(Type.String()),
  }),
  async execute(_toolCallId: string, params: any, signal: AbortSignal | undefined, _onUpdate: unknown, ctx: any) {
    const agentsDir = findPiAgentsDir((ctx && ctx.cwd) || process.cwd());
    const agents = agentsDir ? loadPiAgents(agentsDir) : [];
    const available = agents.map((a) => '"' + a.name + '"').join(", ") || "none";

    const single = Boolean(params.agent && params.task);
    const parallel = (params.tasks && params.tasks.length > 0) || false;
    const modeCount = (single ? 1 : 0) + (parallel ? 1 : 0);
    if (modeCount !== 1) {
      return {
        content: [{ type: "text", text: "Invalid parameters. Available agents: " + available + "." }],
        details: { results: [] },
        isError: true,
      };
    }

    const baseCwd = (params && params.cwd) || (ctx && ctx.cwd) || process.cwd();
    const assistantText = (messages: any[]) =>
      messages
        .filter((m) => m.role === "assistant")
        .map((m) => (typeof m.content === "string" ? m.content : JSON.stringify(m.content)))
        .join("\\n\\n");

    if (single) {
      const agent = agents.find((a) => a.name === params.agent);
      if (!agent) {
        return {
          content: [{ type: "text", text: 'Unknown agent: "' + params.agent + '". Available agents: ' + available + "." }],
          details: { results: [] },
          isError: true,
        };
      }
      const result = await runPiSubagent(agent, params.task, baseCwd, { signal: signal });
      return {
        content: [{ type: "text", text: assistantText(result.messages) || "(no output)" }],
        details: { results: [result] },
      };
    }

    const results = await mapWithConcurrencyLimit(params.tasks, 4, (t: any) => {
      const agent = agents.find((a) => a.name === t.agent);
      if (!agent) {
        return Promise.resolve({
          agent: t.agent,
          task: t.task,
          exitCode: 1,
          messages: [],
          stderr: 'Unknown agent: "' + t.agent + '". Available agents: ' + available + ".",
        });
      }
      return runPiSubagent(agent, t.task, baseCwd, { signal: signal });
    });

    const summaries = results.map((r) => {
      return "### [" + r.agent + "]\\n\\n" + (assistantText(r.messages) || "(no output)");
    });
    return {
      content: [{ type: "text", text: summaries.join("\\n\\n---\\n\\n") || "(no output)" }],
      details: { results: results },
    };
  },
});

export default function bpExtension(api: ExtensionAPI) {

  api.on("session_start", (_event, ctx) => {
    if (isDisabled()) return;
    const cwd = (ctx && ctx.cwd) || process.cwd();
    if (!hasBpConfig(cwd)) return;
    const prompt = ctx && typeof ctx.getSystemPrompt === "function" ? ctx.getSystemPrompt() : "";
    const agentType = detectAgentType(prompt);
    const state = readBpState(cwd);
    const body = augmentBody(agentType, cwd, state.activeChangeName);
    api.sendMessage(buildStateMessage("bp-context", body));
  });


  api.registerTool(bpSubagentTool);
}
"
`;
