            "command": "node .claude/hooks/bp-claude-handler.mjs PreToolUse"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/bp-claude-handler.mjs PostToolUse"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
